APP_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./trustcargo.db
UPLOAD_DIR=uploads
STORAGE_BACKEND=local
# Render: STORAGE_BACKEND=supabase. Never expose this key in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=trustcargo-evidence
# Render DATABASE_URL: use the Session pooler URI (port 5432), with
# postgresql:// and ?sslmode=require. Keep your actual URI in private env vars.

# Email invitations (optional). Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
